    ]
  },
  "local_filter": {
    "comment": "A local station is the affiliate feed of one city or one region, or a municipal and community-access channel, so it is of no use to a list shared between viewers in different places. Every pattern here is matched case sensitively: case insensitively a call sign would swallow ordinary words such as 'Warner' and 'West', and the state suffix is anchored to the end of the name so a leading 'SA' still reads as the Bolivian football club SA Bulo Bulo. A call sign is only read as one for a channel published for a country that uses them: a KQSL is a US station even where iptv-org files it under Canada, while 'Terra Mater WILD' and 'TV-WEST' are not stations at all. A source id ending in 'locals' marks the same kind of station even when the display name carries no call sign.",
    "call_sign_countries": [
      "US",
      "CA"
    ],
    "name_patterns": [
      "\\bcity\\s+of\\b",
      "\\bcounty\\b",
      "\\bgovernment\\b",
      "\\bcommunity\\s+access\\b",
      "\\bcan\\s*tv\\s*\\d",
      "\\bkey\\s+west\\b",
      "\\bflorida\\s+keys\\b"
    ],
    "call_sign_patterns": [
      "\\b[KW][A-Z]{3}(?:-(?:TV|DT|LD))?\\b"
    ],
    "case_sensitive_name_patterns": [
      "(?:^|\\s)(?:NSW|QLD|TAS|VIC|WA|ACT|NT|SA)\\s*$"
    ],
    "reference_patterns": [
      "(?:^|[._])locals?\\d*\\b"
    ]
  },
  "radio_filter": {
    "comment": "Disabled for txt rebuild (no music category).",
    "categories": [],
    "name_patterns": [],
    "case_sensitive_name_patterns": []
  },
  "event_filter": {
    "comment": "TheSportsDB expiry stays off: live games are ordered by cached fixture kickoffs (event_start) and txt date hints, not by an external fixture lookup.",
    "enabled": false,
    "durations": {},
