{
  "version": 2,
  "default": "entertainment",
  "categories": {
    "news": {
      "name": "News",
      "aliases": ["news", "news + opinion", "local news", "current affairs"]
    },
    "sports": {
      "name": "Sports",
      "aliases": ["sports", "sport", "outdoor;sports", "public;sports", "news;sports", "general;sports", "kids;sports", "culture;sports", "entertainment;sports"]
    },
    "sky-sports": {
      "name": "Sky Sports",
      "aliases": ["sky sports"],
      "name_patterns": ["\\bsky\\s*sports?\\b", "\\bsky\\s*mix\\b"]
    },
    "tsn": {
      "name": "TSN",
      "aliases": ["tsn"],
      "name_patterns": ["\\btsn\\b", "\\bteletoon\\b"]
    },
    "tnt-sports": {
      "name": "TNT Sports",
      "aliases": ["tnt sports", "tnt sport"],
      "name_patterns": ["\\btnt\\s*sports?\\b", "\\btnt\\s*go\\b"]
    },
    "stan-sports": {
      "name": "Stan Sports",
      "aliases": ["stan sports", "stan sport"],
      "name_patterns": ["\\bstan\\s*sport\\b", "\\b10\\s*stan\\s*sport\\b"]
    },
    "bein-sports": {
      "name": "beIN Sports",
      "aliases": ["bein sports", "beinsports", "bein sport"],
      "name_patterns": ["\\bbein\\s*sports?\\b", "\\bbeinsports\\b"]
    },
    "soccer": {
      "name": "Soccer",
      "aliases": ["live - soccer", "soccer", "football"],
      "name_patterns": ["\\blive\\s*-\\s*soccer\\b", "\\bsoccer\\b", "\\bfutbol\\b", "\\bfussball\\b"]
    },
    "nfl": {
      "name": "NFL",
      "aliases": ["live - american football", "american football", "nfl"],
      "name_patterns": ["\\blive\\s*-\\s*american\\s*football\\b", "\\bnfl\\b", "\\bamerican\\s*football\\b"]
    },
    "nba": {
      "name": "NBA",
      "aliases": ["live - basketball", "basketball", "nba"],
      "name_patterns": ["\\blive\\s*-\\s*basketball\\b", "\\bnba\\b"]
    },
    "ufc": {
      "name": "UFC",
      "aliases": ["ufc", "mma"],
      "name_patterns": ["\\bufc\\b", "\\bmma\\b", "\\bbellator\\b", "\\bpfl\\b"]
    },
    "entertainment": {
      "name": "Entertainment",
      "aliases": ["entertainment", "general", "classic tv", "comedy", "drama", "reality", "series", "competition reality", "variety", "culture", "interactive"]
    },
    "movies": {
      "name": "Movies & Premium",
      "aliases": ["movies", "movies & premium", "movie channels", "westerns", "true crime", "film"]
    },
    "music": {
      "name": "Music",
      "aliases": ["music", "music videos", "radio"]
    },
    "kids": {
      "name": "Kids & Family",
      "aliases": ["kids", "kids & family", "anime", "children", "animation", "family", "education"]
    },
    "documentary": {
      "name": "Documentary & Reality",
      "aliases": ["documentary", "documentary & reality", "animals + nature", "history + science", "science + nature", "home + food", "cooking", "travel", "outdoor", "lifestyle", "religious", "science"]
    }
  },
  "language_filter": {
    "comment": "Keep English-language channels in the listed categories. A channel is only removed when a source positively identifies a non-English language; unknown is kept, because a missing language record is not evidence of anything. Regenerate the index with scripts/languages/build_index.py.",
    "keep": ["eng"],
    "categories": [
      "documentary",
      "entertainment",
      "kids",
      "movies",
      "music",
      "news",
      "sports"
    ],
    "except_categories": ["bein-sports"],
    "except_channels": [
      "tbc1",
      "tbc2",
      "dodoma-tv"
    ],
    "unknown": "keep"
  },
  "quality_filter": {
    "comment": "Music is limited to SD, 24/7 channels. SD means below 720, so 480p and 576p are kept and 720p and above are dropped. An unknown resolution is kept rather than assumed to be HD.",
    "categories": ["music"],
    "max_height": 719,
    "require_247": true
  },
  "event_filter": {
    "comment": "Live-event channels are named after the match they carry. scripts/events/fixture_schedule.py resolves the kickoff time from TheSportsDB and stores it as event_start, and a channel is dropped once its fixture window has passed. A channel with no resolved kickoff is never removed, because a missing fixture is not evidence that the event finished.",
    "enabled": true,
    "durations": {
      "Soccer": 2.0,
      "Basketball": 2.5,
      "American Football": 3.5,
      "Motorsport": 3.0,
      "Ice Hockey": 2.5,
      "Fighting": 3.0
    },
    "default_duration": 2.5
  },
  "exclude": {
    "categories": ["regional", "business", "weather"],
    "group_patterns": [
      "^live\\s*-\\s*baseball$",
      "^live\\s*-\\s*hockey$",
      "^live\\s*-\\s*racing$",
      "^live\\s*-\\s*tennis$",
      "^live\\s*-\\s*other\\s*events$"
    ],
    "name_patterns": [
      "\\bweather\\w*",
      "\\baccuweather\\b",
      "\\bmeteo\\b",
      "\\bstorm\\s*team\\b",
      "\\bfirst\\s*alert\\b",
      "\\bbig\\s*brother\\s*(camera|quad|feed|house)\\b",
      "\\bbb\\s*camera\\b",
      "\\bbusiness\\b",
      "\\bcnbc\\b",
      "\\bbloomberg\\b",
      "\\bnew\\s+york\\b",
      "\\blos\\s+angeles\\b",
      "\\bchicago\\b",
      "\\bhouston\\b",
      "\\bphoenix\\b",
      "\\bphiladelphia\\b",
      "\\bsan\\s+antonio\\b",
      "\\bsan\\s+diego\\b",
      "\\bdallas\\b",
      "\\bsan\\s+jose\\b",
      "\\baustin\\b",
      "\\bjacksonville\\b",
      "\\bcolumbus\\b",
      "\\bcharlotte\\b",
      "\\bindianapolis\\b",
      "\\bseattle\\b",
      "\\bdenver\\b",
      "\\bboston\\b",
      "\\bnashville\\b",
      "\\bbaltimore\\b",
      "\\bmiami\\b",
      "\\batlanta\\b",
      "\\bmilwaukee\\b",
      "\\bportland\\b",
      "\\blas\\s+vegas\\b",
      "\\bdetroit\\b",
      "\\bmemphis\\b",
      "\\blouisville\\b",
      "\\bsan\\s+francisco\\b",
      "\\bminneapolis\\b",
      "\\bnew\\s+orleans\\b",
      "\\bpittsburgh\\b",
      "\\bcleveland\\b",
      "\\bst\\.?\\s*louis\\b",
      "\\bkansas\\s+city\\b",
      "\\btampa\\b",
      "\\borlando\\b",
      "\\bcharlotte\\b"
    ],
    "channels": [
      "fox-business",
      "cnbc",
      "cnbc-world",
      "bloomberg-tv",
      "al-arabiya-business",
      "al-arabia-business"
    ]
  }
}
