  "region_filter": {
    "comment": "One channel is published under one name, so the same feed repeated once per region is collapsed to a single entry. A record is only ever folded into a record that already exists under the unqualified name, which is what keeps 'Trace Africa' and 'Trace Naija' apart while collapsing 'Angel TV Arabia' into 'Angel TV'. The winner is the unqualified name, then a record from an allowed country, then the lowest id. The bare words below are the region and language qualifiers sources append; a country in brackets and a trailing country code are recognised without being listed here.",
    "words": [
      "africa",
      "america",
      "arabia",
      "arabic",
      "asia",
      "australia",
      "balkans",
      "brazil",
